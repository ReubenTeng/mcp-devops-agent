# Copy this file to .env in the server's launch directory.
# Add credentials only for the providers you want to use.
# Keep unused credential fields empty. Do not commit your .env file.

# Optional: Set the application directories that the server can access.
# Use a JSON array of absolute paths. The default is the launch directory.
# MCP_DEVOPS_PROJECT_ROOTS='["/absolute/path/to/your-app"]'

# Optional: Set a private state directory outside your application directories.
# The default is ~/.local/state/mcp-devops-agent.
# Use an absolute path. The server does not expand ~ in this setting.
# MCP_DEVOPS_STATE_DIR=/absolute/path/to/private-infrastructure-state

# Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Supabase
# Supply the organization slug and region when you create a plan.
SUPABASE_ACCESS_TOKEN=

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub Pages: Existing public repository with prebuilt static content.
GITHUB_TOKEN=

# Optional: Explicit adapter installations with SHA-256 checksums.
# An empty list does not install additional adapters.
MCP_DEVOPS_ADAPTERS='[]'

# Optional: Official JSON catalog URLs for provider discovery.
# Network discovery also requires allowNetwork=true in the tool request.
MCP_DEVOPS_DISCOVERY_SOURCES='[]'
